{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "club.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
